# =============================================================================
# .env.example — reference for every environment variable the skills in this
# repo read. COPY NOTHING SECRET INTO THE REPO. This file documents shapes and
# locations; the real values live outside git.
# =============================================================================

# -----------------------------------------------------------------------------
# snq — ServiceNow CLI
# -----------------------------------------------------------------------------
# snq does NOT read a .env file. Its credential is a browser-captured session
# written by `snq auth` to:
#
#     ~/.config/snq/session          (chmod 600, outside the repo)
#
# That file is generated, not hand-edited. Its shape, for reference only:
#
#     SNQ_COOKIE='JSESSIONID=...; glide_user_route=...; BIGipServerpool_...=...'
#     SNQ_USER_TOKEN='<window.g_ck CSRF token>'
#     SNQ_CAPTURED_AT='2026-08-07T19:04:00Z'
#     SNQ_CAPTURED_USER='rmata'
#
# Never paste a real cookie or token into this repo, a transcript, or a ticket.
# It is a live production session for a system that holds PHI.

# Optional overrides you MAY set in your shell:

# Target a different instance (default comes from config/instance.conf).
# SNQ_INSTANCE=https://chenmeddev.service-now.com

# Move the config/session directory (default ~/.config/snq).
# SNQ_CONFIG_DIR=/Users/you/.config/snq

# curl timeout in seconds (default 45).
# SNQ_TIMEOUT=45

# -----------------------------------------------------------------------------
# dbq — database CLI  (see skills/setting-up-dbq)
# -----------------------------------------------------------------------------
# Real credentials live in ~/.config/dbq/env and ~/.config/dbq/my.cnf (chmod 600),
# written by `dbq init`. Shapes only:
#
#     MONGO_URI_MEDICATION='mongodb+srv://USER:PASS@host/...'
#     MONGO_URI_TENANT_MGMT='mongodb+srv://USER:PASS@host/...'
#     MYSQL_PROD_PASSWORD='...'
#
# DBQ_CONFIG_DIR=/Users/you/.config/dbq
# DBQ_DB=patient-prescription-query
