#!/usr/bin/env bash
# The SDLC-skills local standards overlay moved to its own private repo, rjmata95/sdlc-standards,
# so teammates can share it without access to this repo. This shim forwards there.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
target="${SDLC_STANDARDS_REPO:-$(cd "$here/.." && pwd)/sdlc-standards}"
[ -x "$target/bin/sdlc-overlay" ] || {
  echo "no sdlc-standards checkout at $target" >&2
  echo "git clone git@github.com:rjmata95/sdlc-standards.git $target" >&2; exit 2; }
echo "note: overlay lives in $target -- commit there, not here." >&2
exec "$target/bin/sdlc-overlay" "$@"
